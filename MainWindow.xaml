<Window x:Class="MtdVpn.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MTD VPN" Width="380" Height="700" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" Background="#14141C" FontFamily="Segoe UI">
  <Window.Resources>
    <Style x:Key="Switch" TargetType="ToggleButton">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Track" Width="160" Height="80" CornerRadius="40" Background="#3A3A4A">
              <Ellipse x:Name="Knob" Width="64" Height="64" Fill="White" HorizontalAlignment="Left" Margin="8,0,0,0"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Track" Property="Background" Value="#2ECC71"/>
                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                <Setter TargetName="Knob" Property="Margin" Value="0,0,8,0"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Track" Property="Opacity" Value="0.5"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Btn" TargetType="Button">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Background" Value="#FF6B35"/>
      <Setter Property="Padding" Value="16,10"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Ghost" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Background" Value="#2A2A38"/>
    </Style>
  </Window.Resources>

  <Grid Margin="28">
    <!-- Приветствие -->
    <StackPanel x:Name="WelcomePanel" VerticalAlignment="Center">
      <TextBlock Text="🔒" FontSize="64" HorizontalAlignment="Center"/>
      <TextBlock Text="Добро пожаловать!" Foreground="White" FontSize="26" FontWeight="SemiBold"
                 HorizontalAlignment="Center" Margin="0,12,0,6"/>
      <TextBlock Text="Вставьте ссылку на подключение, которую вам выдали."
                 Foreground="#9A9AB0" FontSize="14" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,24"/>
      <TextBox x:Name="TxtUrl" FontSize="14" Padding="10" Background="#1F1F2B" Foreground="White"
               BorderBrush="#3A3A4A" CaretBrush="White"/>
      <Button x:Name="BtnContinue" Content="Продолжить" Style="{StaticResource Btn}" Margin="0,16,0,0"
              FontSize="15" Click="BtnContinue_Click"/>
    </StackPanel>

    <!-- Главный экран -->
    <Grid x:Name="MainPanel" Visibility="Collapsed">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Grid Grid.Row="0">
        <TextBlock Text="MTD VPN" Foreground="White" FontSize="20" FontWeight="SemiBold"/>
        <Button Content="Журнал" Style="{StaticResource Ghost}" HorizontalAlignment="Right" Padding="10,4" Click="BtnLog_Click"/>
      </Grid>

      <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
        <ToggleButton x:Name="Switch" Style="{StaticResource Switch}" Click="Switch_Click"/>
        <TextBlock x:Name="TxtStatus" Text="Отключено" Foreground="White" FontSize="20" FontWeight="SemiBold"
                   HorizontalAlignment="Center" Margin="0,24,0,4"/>
        <TextBlock x:Name="TxtServer" Text="" Foreground="#9A9AB0" FontSize="13" HorizontalAlignment="Center"/>
      </StackPanel>

      <ScrollViewer Grid.Row="2" MaxHeight="360" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="0,0,8,0">
        <TextBlock Text="Сервер" Foreground="#9A9AB0" FontSize="12" Margin="0,0,0,4"/>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <ComboBox x:Name="CmbServer" Padding="8" SelectionChanged="CmbServer_Changed"/>
          <Button Grid.Column="1" Content="Авто" Style="{StaticResource Btn}" Margin="8,0,0,0" Click="BtnAuto_Click"/>
        </Grid>

        <TextBlock x:Name="TxtCount" Foreground="#9A9AB0" FontSize="12" Margin="0,4,0,0"/>
        <TextBlock Text="Профиль" Foreground="#9A9AB0" FontSize="12" Margin="0,14,0,4"/>
        <ComboBox x:Name="CmbProfile" Padding="8" SelectionChanged="CmbProfile_Changed"/>
        <Grid Margin="0,8,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Button Content="+ Добавить профиль" Style="{StaticResource Ghost}" Click="BtnShowAdd_Click"/>
          <Button Grid.Column="2" Content="Удалить" Style="{StaticResource Ghost}" Click="BtnDelete_Click"/>
        </Grid>

        <Expander IsExpanded="True" Header="Туннелирование (нажмите, чтобы свернуть)" Foreground="White" Margin="0,14,0,0">
          <StackPanel Margin="0,8,0,0">
            <ComboBox x:Name="CmbMode" Padding="8" SelectionChanged="CmbMode_Changed">
              <ComboBoxItem Content="Весь трафик через VPN"/>
              <ComboBoxItem Content="Через VPN только выбранные программы"/>
              <ComboBoxItem Content="Все программы, кроме выбранных"/>
            </ComboBox>
            <StackPanel x:Name="AppsPanel" Visibility="Collapsed" Margin="0,8,0,0">
              <ListBox x:Name="LstApps" Height="90" Background="#1F1F2B" Foreground="White" BorderBrush="#3A3A4A"/>
              <Button Content="Выбрать из запущенных программ" Style="{StaticResource Btn}" Margin="0,8,0,0" Click="BtnPickRunning_Click"/>
              <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Button Content="Из файла…" Style="{StaticResource Ghost}" Click="BtnAddApp_Click"/>
                <Button Grid.Column="2" Content="Убрать" Style="{StaticResource Ghost}" Click="BtnRemoveApp_Click"/>
              </Grid>
            </StackPanel>
          </StackPanel>
        </Expander>

        <StackPanel x:Name="AddPanel" Visibility="Collapsed" Margin="0,10,0,0">
          <TextBox x:Name="TxtNewUrl" Padding="10" Background="#1F1F2B" Foreground="White"
                   BorderBrush="#3A3A4A" CaretBrush="White"/>
          <Button Content="Сохранить" Style="{StaticResource Btn}" Margin="0,8,0,0" Click="BtnAdd_Click"/>
        </StackPanel>
      </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>
